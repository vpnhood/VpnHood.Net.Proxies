<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Description>Standard SOCKS5, SOCKS4/4a, HTTP and HTTPS proxy clients and servers for .NET. An independent, reusable, cross-platform library: async, cancellation-aware, IPv6-ready, with username/password and Basic authentication and SOCKS5 UDP ASSOCIATE support.</Description>
		<PackageTags>proxy;socks5;socks4;http-proxy;https-proxy;socks;connect;udp;proxy-server;proxy-client;dotnet</PackageTags>
		<PackageIcon>VpnHood.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<!-- The whole public API is documented: a missing or broken doc comment fails the build, so it stays that
		     way. CS1591 must never be in NoWarn as well, because NoWarn beats WarningsAsErrors. -->
		<WarningsAsErrors>$(WarningsAsErrors);CS0419;CS1570;CS1571;CS1572;CS1573;CS1574;CS1580;CS1581;CS1584;CS1587;CS1589;CS1590;CS1591;CS1592;CS1658;CS1710;CS1711;CS1712;CS1723;CS1734;CS1735</WarningsAsErrors>
		<IsTrimmable>true</IsTrimmable>
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\VpnHood.png" Link="Resources\VpnHood.png" Pack="true" PackagePath="\" />
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
	</ItemGroup>
</Project>
